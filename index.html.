        </div>
      )}

      {/* Minimal Fixed Bottom Status Bar */}
      <footer className="fixed bottom-0 left-0 right-0 z-40 px-6 md:px-12 py-4 flex items-center justify-between pointer-events-none text-[10px] uppercase tracking-[0.25em] text-white/30 font-sans-luxury">
        <div>© {new Date().getFullYear()} ASTRUT TIMEPIECE SA</div>
        <div className="hidden sm:flex items-center space-x-2">
          <span>Progression</span>
          <div className="w-20 h-[2px] bg-white/10 rounded-full overflow-hidden">
            <div
              className="h-full bg-[#c9a96e] transition-all duration-75 ease-out"
              style={{ width: `${Math.round(scrollProgress * 100)}%` }}
            />
          </div>
          <span>{Math.round(scrollProgress * 100)}%</span>
        </div>
        <div>Swiss Made</div>
      </footer>
